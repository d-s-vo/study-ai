#!/usr/bin/env bash
# commit-msg (КЛИЕНТСКИЕ репы, МОДУЛЬ M6) — чистит сообщение коммита от следов агента.
# $1 — путь к файлу с сообщением коммита.  ⇐ ИНВАРИАНТ №7.
set -u

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
GITHOOKS_DIR="$(dirname "$HOOK_DIR")"
. "$GITHOOKS_DIR/lib/scan.sh"

msg_file="$1"
fail=0
say() { printf '%s\n' "$*" >&2; }

# 1. Стоп-словарь по всему сообщению (вкл. ~wip~, FEAT-, claude, оркестратор...).
report="$(scan_text_file "$msg_file")"
if [ -n "$report" ]; then
    say "БЛОК: сообщение коммита содержит стоп-слова:"
    printf '%s\n' "$report" >&2
    fail=1
fi

# 2. Явный блок трейлеров авторства ИИ (на случай нестандартного написания).
if grep -qiE '^[[:space:]]*(co-authored-by|generated[ -]*with|generated by)' "$msg_file"; then
    say "БЛОК: в сообщении есть трейлер авторства ИИ (Co-Authored-By / Generated with)."
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    say ""
    say "Сообщение коммита отклонено. Перепишите его без следов агента/ИИ."
    exit 1
fi
exit 0
