# study-cbook-ai: внутренний репозиторий знаний агентской разработки.
# Здесь живут ТОЛЬКО артефакты системы. Код клиентских репозиториев — никогда.

# --- Двухконтурная модель (M1): worktree и bare-клоны клиентских реп (код заказчика) ---
# При OFF (контуры совпадают) эти строки не нужны — их убирает агент-развёртыватель.
/.repos/
/cbook/
/prod/
/tasks/

# --- Локальная инфраструктура: секреты, логи, данные ---
/local/*
!/local/docker-compose.yml
# (добавьте сюда версионируемые исключения инфраструктуры по мере надобности)

# --- Секреты — на любом уровне ---
*.env
.env*
team.env
*_rsa
*_ed25519
*.pem
*.key

# --- Файл-разрешение доставки (создаёт deliver.sh/пользователь) ---
/.push-allow

# --- Временный слепок состояния слоя синхронизации (fallback, пока нет ai/state.json) ---
/.state.json

# --- Координационный слой: эфемерное присутствие агентов и мьютексы (НЕ коммитим).
#     bookings/ и archive/ — коммитятся (общая доска броней). ---
/ai/coord/agents/
/ai/coord/locks/
/ai/coord/fetch-state.json

# --- Мусор ---
.DS_Store
.lh/
node_modules/
__pycache__/
*.log
